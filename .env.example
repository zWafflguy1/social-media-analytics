# ──────────────────────────────────────────────────────────────────────────────
# Social Media Analytics Dashboard — Environment Variables
# Copy this file to .env.local and fill in your values.
# ──────────────────────────────────────────────────────────────────────────────

# NextAuth — required
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-random-secret-here

# Your app's URL (change for production)
NEXTAUTH_URL=http://localhost:3000

# ─── Meta (Facebook + Instagram + Ads) ───────────────────────────────────────
# From https://developers.facebook.com → Your App → Settings → Basic
META_APP_ID=your-facebook-app-id
META_APP_SECRET=your-facebook-app-secret

# ─── LinkedIn ─────────────────────────────────────────────────────────────────
# From https://developer.linkedin.com → Your App → Auth
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
