# ── Required ────────────────────────────────────────────────────────────────
# Claude API key — powers the optimization agent and AEO visibility checks
ANTHROPIC_API_KEY=sk-ant-...

# The website this agent optimizes
SITE_URL=https://www.example.com
BUSINESS_NAME=Example Plumbing Co.

# Comma-separated list of services the business offers
SERVICES=emergency plumbing,water heater repair,drain cleaning

# The local market (city/region) to rank in
MARKET=Austin, TX

# ── Recommended ─────────────────────────────────────────────────────────────
# SerpAPI key (https://serpapi.com) — real-time Google SERP + local pack data.
# Without it, SERP rank tracking is disabled (audits + AEO checks still run).
SERPAPI_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
PORT=8787
# How often the agent runs a full optimization cycle (hours)
AGENT_INTERVAL_HOURS=6
# Max pages to crawl per audit cycle
CRAWL_MAX_PAGES=25
# Site key used by the embed script to authenticate (auto-generated if empty)
SITE_KEY=
# Where the JSON datastore lives
DATA_DIR=./data
