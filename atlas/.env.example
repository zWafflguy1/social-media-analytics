# ──────────────────────────────────────────────────────────────────────────────
# Atlas — AI Knowledge Layer — Environment Variables
# Copy to .env.local and fill in.
# ──────────────────────────────────────────────────────────────────────────────

# Postgres with the pgvector extension installed.
# Local quickstart:  docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=atlas pgvector/pgvector:pg16
DATABASE_URL=postgres://postgres:atlas@localhost:5432/atlas

# Anthropic API key — powers enrichment, retrieval, chat, briefs, agents.
ANTHROPIC_API_KEY=sk-ant-...

# Model tier configuration (override if needed).
ATLAS_MODEL_HEAVY=claude-opus-4-8
ATLAS_MODEL_FAST=claude-sonnet-4-6
ATLAS_MODEL_CHEAP=claude-haiku-4-5-20251001

# Embeddings. Atlas ships with a deterministic local embedder so it runs with
# zero extra dependencies; set a provider here to use real embeddings.
#   ATLAS_EMBEDDING_PROVIDER=voyage   (recommended for production)
ATLAS_EMBEDDING_PROVIDER=local
VOYAGE_API_KEY=

# Ingestion auth — connectors must present this shared secret.
ATLAS_INGEST_SECRET=change-me-to-a-long-random-string

# Action autonomy: highest permission tier the agent may execute WITHOUT a human.
# 0=read-only 1=draft 2=act-with-approval 3=autonomous. Start at 1.
ATLAS_MAX_AUTONOMY_TIER=1

# Master kill switch for all Tier-2/Tier-3 actions. true = no actions execute.
ATLAS_ACTIONS_FROZEN=false
