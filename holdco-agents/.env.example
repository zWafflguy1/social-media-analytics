# ============================================================================
# REQUIRED — agents won't run without these
# ============================================================================
ANTHROPIC_API_KEY=sk-ant-...
RESEND_API_KEY=re_...
REPORT_TO_EMAIL=zjones@gowaffl.com
REPORT_FROM_EMAIL=reports@yourholdco.com   # must be a verified Resend sender

# ============================================================================
# OPTIONAL — features degrade gracefully if absent
# ============================================================================

# Broker email parsing (set when you have a dedicated deals@ inbox)
BROKER_INBOX_HOST=imap.gmail.com
BROKER_INBOX_PORT=993
BROKER_INBOX_USER=deals@yourholdco.com
BROKER_INBOX_PASS=                          # app password, not real password

# Social signal scraping
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=holdco-agents/0.1 by yourname
X_BEARER_TOKEN=                             # Twitter/X API v2 bearer
# LinkedIn signal scraping uses Playwright headless; no key required but TOS-sensitive.

# Investor CRM enrichment (public sources)
SEC_EDGAR_USER_AGENT=HoldCo Research zjones@gowaffl.com

# Dashboard auth — magic link via email. The secret signs session cookies and
# magic-link tokens. Generate with: openssl rand -hex 32
DASHBOARD_SECRET=
# Comma-separated allowlist of emails permitted to sign in. Anyone else who
# requests a magic link gets silently denied (no link sent).
DASHBOARD_ALLOWED_EMAILS=zjones@gowaffl.com

# ============================================================================
# TUNING — sensible defaults baked in, override here
# ============================================================================
TARGET_EV_MIN=1000000
TARGET_EV_MAX=10000000
MIN_DEAL_SCORE_FOR_MATCH=70                 # 0-100; below this, deal doesn't trigger matcher
WEEKLY_REPORT_CRON=0 5 * * 1                # Mon 5 AM, server timezone
DEAL_SCOUT_CRON=0 */6 * * *                 # every 6 hours
RISK_SCAN_CRON=0 7 * * *                    # daily 7 AM
INVESTOR_ENRICHER_CRON=0 3 * * 6            # Sat 3 AM
DB_PATH=./data/holdco.db
