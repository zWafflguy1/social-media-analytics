{
  "name": "holdco-agents",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous AI agent system for sourcing, capitalizing, and managing a holding company portfolio of lower-middle-market absentee-run businesses.",
  "scripts": {
    "db:init": "tsx scripts/init-db.ts",
    "db:seed": "tsx scripts/seed-lenders.ts && tsx scripts/seed-investors.ts",
    "scout": "tsx agents/deal-scout/index.ts",
    "match": "tsx agents/capital-matcher/index.ts",
    "debt": "tsx agents/debt-architect/index.ts",
    "cfo": "tsx agents/portfolio-cfo/index.ts",
    "enrich": "tsx agents/investor-enricher/index.ts",
    "report": "tsx agents/portfolio-cfo/weekly-report.ts",
    "scheduler": "tsx scheduler/index.ts",
    "dashboard": "next dev dashboard -p 3000",
    "dashboard:build": "next build dashboard",
    "dashboard:start": "next start dashboard -p 3000",
    "start": "concurrently -n scheduler,dashboard \"npm run scheduler\" \"npm run dashboard\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "better-sqlite3": "^11.3.0",
    "cheerio": "^1.0.0",
    "node-cron": "^3.0.3",
    "playwright": "^1.48.0",
    "resend": "^4.0.0",
    "imapflow": "^1.0.171",
    "mailparser": "^3.7.1",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8",
    "dotenv": "^16.4.5",
    "concurrently": "^9.0.1",
    "marked": "^14.1.3",
    "puppeteer": "^23.6.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.5",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/mailparser": "^3.4.5",
    "tailwindcss": "^3.4.13",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
